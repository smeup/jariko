     D HI              S             10     VARYING INZ(*HIVAL)
     D LO              S             10     VARYING INZ(*LOVAL)
     D L1              S              5  0
     C                   EVAL      L1=%LEN(HI)
     C     L1            DSPLY     
     C                   EVAL      L1=%LEN(LO)
     C     L1            DSPLY     
